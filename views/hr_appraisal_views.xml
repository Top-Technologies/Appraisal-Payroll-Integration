<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_appraisal_form_inherit_all" model="ir.ui.view">
        <field name="name">hr.appraisal.form.inherit.all</field>
        <field name="model">hr.appraisal</field>
        <field name="inherit_id" ref="hr_appraisal.view_hr_appraisal_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[contains(@class, 'o_appraisal_both_feedback')]" position="before">
                <group col="2" class="mb-2">
                    <field name="self_overall_performance" string="Average Self Rating (/ 5)" readonly="1"/>
                    <field name="mgr_overall_performance" string="Average Manager Rating (/ 5)" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <!-- TAB 1: PAYROLL & COMPENSATION (Requirements 1 & 2) -->
                <page string="Payroll &amp; Compensation" name="payroll_compensation">
                    <group>
                        <group string="Employment Details">
                            <field name="employment_start_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current Pay Breakdown (Read-Only)">
                            <field name="basic_salary_kp"/>
                            <field name="fuel_allowance_kp"/>
                            <field name="house_allowance_kp"/>
                            <field name="mobile_allowance_kp"/>
                            <field name="position_allowance_kp"/>
                            <field name="taxable_transport_allowance_kp"/>
                            <field name="non_taxable_transport_allowance_kp"/>
                            <field name="taxable_salary_kp"/>
                            <field name="income_tax_kp"/>
                            <field name="loan_advance_kp"/>
                            <field name="employee_pension_7_kp"/>
                            <field name="employee_pension_11_kp"/>
                            <field name="net_salary_kp"/>
                        </group>
                        <group string="Proposed Adjustments &amp; New Package">
                            <field name="proposed_job_id"/>
                            <field name="proposed_basic_salary_kp"/>
                            <field name="proposed_fuel_allowance_kp"/>
                            <field name="proposed_house_allowance_kp"/>
                            <field name="proposed_mobile_allowance_kp"/>
                            <field name="proposed_position_allowance_kp"/>
                            <field name="proposed_taxable_transport_allowance_kp"/>
                            <field name="proposed_non_taxable_transport_allowance_kp"/>
                            <field name="proposed_net_salary_kp"/>
                        </group>
                    </group>
                </page>

                <!-- TAB 2: TRAININGS & CERTIFICATIONS (Requirement 7) -->
                <page string="Trainings &amp; Certifications" name="trainings_taken">
                    <group string="Employee Training Attendances">
                        <field name="training_attendance_ids" nolabel="1" readonly="1" colspan="2">
                            <list create="0" edit="0" delete="0">
                                <field name="employee_id" optional="hide"/>
                                <field name="name" string="Training Title"/>
                                <field name="date_start" string="Date"/>
                                <field name="line_type_id" string="Resume Section"/>
                                <field name="certificate_filename" column_invisible="1"/>
                                <field name="certificate_file" string="Certificate" filename="certificate_filename" widget="binary"/>
                            </list>
                        </field>
                    </group>
                    <group string="Suggested Training Goals">
                        <field name="suggested_training_goal_ids" nolabel="1" readonly="state == '3_done'" colspan="2">
                            <list editable="bottom">
                                <field name="training_name"/>
                                <field name="description"/>
                                <field name="target_date"/>
                                <field name="goal_id" string="Tracked Goal" options="{'no_create': True}"/>
                                <field name="goal_progression" string="Progress" widget="badge"/>
                            </list>
                        </field>
                        <div class="text-muted">
                            <span>When the appraisal is marked Done, each suggestion is added to the employee's Goals with the Training tag.</span>
                        </div>
                    </group>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_trainings_taken" class="oe_subtotal_footer_separator"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_hr_appraisal_goal_form_inherit_source_appraisal" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.form.inherit.source.appraisal</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="inherit_id" ref="hr_appraisal.hr_appraisal_goal_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deadline']" position="after">
                <field name="source_appraisal_id" readonly="1" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_appraisal_goal_tree_inherit_source_appraisal" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.list.inherit.source.appraisal</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="inherit_id" ref="hr_appraisal.hr_appraisal_goal_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="source_appraisal_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
