<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Custom Paper Format: Clean Portrait A4 with standard margins -->
    <record id="paperformat_appraisal_portrait" model="report.paperformat">
        <field name="name">Appraisal Portrait A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">96</field>
    </record>

    <!-- Appraisal PDF Report Action: Registered under the Print / Action menu -->
    <record id="action_report_hr_appraisal" model="ir.actions.report">
        <field name="name">Appraisal PDF</field>
        <field name="model">hr.appraisal</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">Appraisal_Payroll_Integration.report_appraisal_document</field>
        <field name="report_file">Appraisal_Payroll_Integration.report_appraisal_document</field>
        <field name="paperformat_id" ref="paperformat_appraisal_portrait"/>
        <field name="print_report_name">'Appraisal - %s' % (object.employee_id.name or 'Employee')</field>
        <field name="binding_model_id" ref="hr_appraisal.model_hr_appraisal"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
