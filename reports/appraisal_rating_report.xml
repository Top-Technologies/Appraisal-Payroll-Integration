<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_appraisal_document_with_ratings"
              inherit_id="appraisal_payroll_integration.report_appraisal_document">
        <!-- Append only the calculated average; the original pasted document stays unchanged. -->
        <xpath expr="//div[t[@t-elif='o.employee_feedback']]" position="inside">
            <div style="margin-top: 12px; padding: 8px 10px; background-color: #eaf2f8; font-size: 12px; page-break-inside: avoid;">
                <strong>Average of entered self-ratings: </strong>
                <span t-field="o.self_overall_performance"/> / 5
            </div>
        </xpath>
        <xpath expr="//div[t[@t-elif='o.manager_feedback']]" position="inside">
            <div style="margin-top: 12px; padding: 8px 10px; background-color: #eaf2f8; font-size: 12px; page-break-inside: avoid;">
                <strong>Average of entered manager ratings: </strong>
                <span t-field="o.mgr_overall_performance"/> / 5
            </div>
        </xpath>
    </template>
</odoo>
